# Copy to .env.local (git-ignored) next to this file, or to $CHANNEL_HUB_HOME/.env.local.
# Values here are names only. Never commit real values.

# Encrypts account tokens in the vault. Use a long random string (for example: openssl rand -base64 48).
CHANNEL_HUB_MASTER_KEY=

# Optional. Defaults: port 8790, data in ~/.channel-hub
# CHANNEL_HUB_PORT=8790
# CHANNEL_HUB_HOME=

# YouTube connector: an OAuth client from Google Cloud Console (YouTube Data API v3 enabled).
# Authorized redirect URI: http://127.0.0.1:8790/oauth/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
